<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.35 0.35 0.35 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>4.8 0.0 13.0 0 1.57 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>500.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Smoke & Dust Corridor Arena: x in [-1.5, 11.2], y in [-2.4, 2.4] -->
    <model name="smoke_hazard_walls">
      <static>1</static>
      <link name="walls">
        <collision name="wall_n_c"><pose>4.85 2.4 0.5 0 0 0</pose><geometry><box><size>12.9 0.2 1.0</size></box></geometry></collision>
        <visual name="wall_n_v"><pose>4.85 2.4 0.5 0 0 0</pose><geometry><box><size>12.9 0.2 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_s_c"><pose>4.85 -2.4 0.5 0 0 0</pose><geometry><box><size>12.9 0.2 1.0</size></box></geometry></collision>
        <visual name="wall_s_v"><pose>4.85 -2.4 0.5 0 0 0</pose><geometry><box><size>12.9 0.2 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_w_c"><pose>-1.5 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 5.0 1.0</size></box></geometry></collision>
        <visual name="wall_w_v"><pose>-1.5 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 5.0 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_e_c"><pose>11.2 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 5.0 1.0</size></box></geometry></collision>
        <visual name="wall_e_v"><pose>11.2 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 5.0 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <!-- Staggered Fire Doors with 0.92m Openings -->
        <collision name="s1_top_c"><pose>2.2 0.72 0.4 0 0 0</pose><geometry><box><size>0.18 3.36 0.8</size></box></geometry></collision>
        <visual name="s1_top_v"><pose>2.2 0.72 0.4 0 0 0</pose><geometry><box><size>0.18 3.36 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="s1_bot_c"><pose>2.2 -2.14 0.4 0 0 0</pose><geometry><box><size>0.18 0.52 0.8</size></box></geometry></collision>
        <visual name="s1_bot_v"><pose>2.2 -2.14 0.4 0 0 0</pose><geometry><box><size>0.18 0.52 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>

        <collision name="s2_bot_c"><pose>5.2 -0.72 0.4 0 0 0</pose><geometry><box><size>0.18 3.36 0.8</size></box></geometry></collision>
        <visual name="s2_bot_v"><pose>5.2 -0.72 0.4 0 0 0</pose><geometry><box><size>0.18 3.36 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="s2_top_c"><pose>5.2 2.14 0.4 0 0 0</pose><geometry><box><size>0.18 0.52 0.8</size></box></geometry></collision>
        <visual name="s2_top_v"><pose>5.2 2.14 0.4 0 0 0</pose><geometry><box><size>0.18 0.52 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>

        <collision name="s3_top_c"><pose>8.2 0.72 0.4 0 0 0</pose><geometry><box><size>0.18 3.36 0.8</size></box></geometry></collision>
        <visual name="s3_top_v"><pose>8.2 0.72 0.4 0 0 0</pose><geometry><box><size>0.18 3.36 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="s3_bot_c"><pose>8.2 -2.14 0.4 0 0 0</pose><geometry><box><size>0.18 0.52 0.8</size></box></geometry></collision>
        <visual name="s3_bot_v"><pose>8.2 -2.14 0.4 0 0 0</pose><geometry><box><size>0.18 0.52 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>

        <!-- Visual-only semi-transparent smoke/soot hazard zones flush under floor trajectories -->
        <visual name="smoke_zone_1"><cast_shadows>false</cast_shadows><transparency>0.62</transparency><pose>1.1 -1.0 0.0008 0 0 0</pose><geometry><cylinder><radius>1.1</radius><length>0.0012</length></cylinder></geometry><material><ambient>0.72 0.58 0.42 0.38</ambient><diffuse>0.78 0.62 0.45 0.38</diffuse><emissive>0.18 0.12 0.06 0.30</emissive></material></visual>
        <visual name="smoke_zone_2"><cast_shadows>false</cast_shadows><transparency>0.62</transparency><pose>3.7 0.2 0.0008 0 0 0</pose><geometry><cylinder><radius>1.3</radius><length>0.0012</length></cylinder></geometry><material><ambient>0.72 0.58 0.42 0.38</ambient><diffuse>0.78 0.62 0.45 0.38</diffuse><emissive>0.18 0.12 0.06 0.30</emissive></material></visual>
        <visual name="smoke_zone_3"><cast_shadows>false</cast_shadows><transparency>0.62</transparency><pose>6.7 -0.2 0.0008 0 0 0</pose><geometry><cylinder><radius>1.3</radius><length>0.0012</length></cylinder></geometry><material><ambient>0.72 0.58 0.42 0.38</ambient><diffuse>0.78 0.62 0.45 0.38</diffuse><emissive>0.18 0.12 0.06 0.30</emissive></material></visual>
      </link>
    </model>
  </world>
</sdf>
