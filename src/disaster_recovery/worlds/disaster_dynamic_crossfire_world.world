<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <scene><shadows>false</shadows></scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>4.8 0.0 13.0 0 1.57 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>500.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Narrow Crossfire Corridor Arena: x in [-1.5, 11.2], y in [-2.3, 2.3] -->
    <model name="dynamic_crossfire_walls">
      <static>1</static>
      <link name="walls">
        <collision name="wall_n_c"><pose>4.85 2.3 0.5 0 0 0</pose><geometry><box><size>12.9 0.2 1.0</size></box></geometry></collision>
        <visual name="wall_n_v"><pose>4.85 2.3 0.5 0 0 0</pose><geometry><box><size>12.9 0.2 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_s_c"><pose>4.85 -2.3 0.5 0 0 0</pose><geometry><box><size>12.9 0.2 1.0</size></box></geometry></collision>
        <visual name="wall_s_v"><pose>4.85 -2.3 0.5 0 0 0</pose><geometry><box><size>12.9 0.2 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_w_c"><pose>-1.5 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 4.8 1.0</size></box></geometry></collision>
        <visual name="wall_w_v"><pose>-1.5 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 4.8 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_e_c"><pose>11.2 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 4.8 1.0</size></box></geometry></collision>
        <visual name="wall_e_v"><pose>11.2 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 4.8 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <!-- Pinch Gate 1 at x=2.5: 1.15m opening y in [-0.575, 0.575] -->
        <collision name="g1_top_c"><pose>2.5 1.4375 0.4 0 0 0</pose><geometry><box><size>0.20 1.725 0.8</size></box></geometry></collision>
        <visual name="g1_top_v"><pose>2.5 1.4375 0.4 0 0 0</pose><geometry><box><size>0.20 1.725 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
        <collision name="g1_bot_c"><pose>2.5 -1.4375 0.4 0 0 0</pose><geometry><box><size>0.20 1.725 0.8</size></box></geometry></collision>
        <visual name="g1_bot_v"><pose>2.5 -1.4375 0.4 0 0 0</pose><geometry><box><size>0.20 1.725 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>

        <!-- Pinch Gate 2 at x=5.4: 1.15m opening y in [0.15, 1.30] -->
        <collision name="g2_bot_c"><pose>5.4 -1.075 0.4 0 0 0</pose><geometry><box><size>0.20 2.45 0.8</size></box></geometry></collision>
        <visual name="g2_bot_v"><pose>5.4 -1.075 0.4 0 0 0</pose><geometry><box><size>0.20 2.45 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
        <collision name="g2_top_c"><pose>5.4 1.80 0.4 0 0 0</pose><geometry><box><size>0.20 1.00 0.8</size></box></geometry></collision>
        <visual name="g2_top_v"><pose>5.4 1.80 0.4 0 0 0</pose><geometry><box><size>0.20 1.00 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>

        <!-- Pinch Gate 3 at x=8.2: 1.15m opening y in [-1.30, -0.15] -->
        <collision name="g3_top_c"><pose>8.2 1.075 0.4 0 0 0</pose><geometry><box><size>0.20 2.45 0.8</size></box></geometry></collision>
        <visual name="g3_top_v"><pose>8.2 1.075 0.4 0 0 0</pose><geometry><box><size>0.20 2.45 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
        <collision name="g3_bot_c"><pose>8.2 -1.80 0.4 0 0 0</pose><geometry><box><size>0.20 1.00 0.8</size></box></geometry></collision>
        <visual name="g3_bot_v"><pose>8.2 -1.80 0.4 0 0 0</pose><geometry><box><size>0.20 1.00 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
      </link>
    </model>

    <!-- 2 Dynamic Crossfire Obstacles (parked in side bays during outbound, active across gates on return) -->
    <model name="dyn_obs_1">
      <pose>2.15 1.65 0.25 0 0 0</pose>
      <link name="link">
        <gravity>0</gravity>
        <inertial>
          <mass>20.0</mass>
          <inertia><ixx>0.5</ixx><iyy>0.5</iyy><izz>0.5</izz></inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.21</radius><length>0.34</length></cylinder></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.21</radius><length>0.50</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
      <plugin name="dyn_obs_1_move" filename="libgazebo_ros_planar_move.so">
        <ros><namespace>/dyn_obs1</namespace></ros>
        <update_rate>20.0</update_rate>
        <publish_odom>false</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
      </plugin>
    </model>

    <model name="dyn_obs_2">
      <pose>5.05 -1.65 0.25 0 0 0</pose>
      <link name="link">
        <gravity>0</gravity>
        <inertial>
          <mass>20.0</mass>
          <inertia><ixx>0.5</ixx><iyy>0.5</iyy><izz>0.5</izz></inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.21</radius><length>0.34</length></cylinder></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.21</radius><length>0.50</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
      <plugin name="dyn_obs_2_move" filename="libgazebo_ros_planar_move.so">
        <ros><namespace>/dyn_obs2</namespace></ros>
        <update_rate>20.0</update_rate>
        <publish_odom>false</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
      </plugin>
    </model>
  </world>
</sdf>
