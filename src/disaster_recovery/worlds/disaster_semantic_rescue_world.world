<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <scene>
      <ambient>0.75 0.75 0.75 1.0</ambient>
      <background>0.82 0.85 0.90 1.0</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>3.0 -3.2 8.2 0 1.18 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>500.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Indoor Disaster Semantic Rescue Arena: x in [-1.2, 7.6], y in [-2.4, 2.4] -->
    <model name="semantic_rescue_arena">
      <static>1</static>
      <link name="walls">
        <!-- Outer perimeter -->
        <collision name="wall_n_c"><pose>3.2 2.4 0.45 0 0 0</pose><geometry><box><size>9.0 0.18 0.9</size></box></geometry></collision>
        <visual name="wall_n_v"><pose>3.2 2.4 0.45 0 0 0</pose><geometry><box><size>9.0 0.18 0.9</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_s_c"><pose>3.2 -2.4 0.45 0 0 0</pose><geometry><box><size>9.0 0.18 0.9</size></box></geometry></collision>
        <visual name="wall_s_v"><pose>3.2 -2.4 0.45 0 0 0</pose><geometry><box><size>9.0 0.18 0.9</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_w_c"><pose>-1.2 0.0 0.45 0 0 0</pose><geometry><box><size>0.18 4.98 0.9</size></box></geometry></collision>
        <visual name="wall_w_v"><pose>-1.2 0.0 0.45 0 0 0</pose><geometry><box><size>0.18 4.98 0.9</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_e_c"><pose>7.6 0.0 0.45 0 0 0</pose><geometry><box><size>0.18 4.98 0.9</size></box></geometry></collision>
        <visual name="wall_e_v"><pose>7.6 0.0 0.45 0 0 0</pose><geometry><box><size>0.18 4.98 0.9</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <!-- Partition 1 (x = 1.45, doorway y in [-0.75, +0.95]) -->
        <collision name="p1_n_c"><pose>1.45 1.67 0.45 0 0 0</pose><geometry><box><size>0.16 1.45 0.9</size></box></geometry></collision>
        <visual name="p1_n_v"><pose>1.45 1.67 0.45 0 0 0</pose><geometry><box><size>0.16 1.45 0.9</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>

        <collision name="p1_s_c"><pose>1.45 -1.57 0.45 0 0 0</pose><geometry><box><size>0.16 1.65 0.9</size></box></geometry></collision>
        <visual name="p1_s_v"><pose>1.45 -1.57 0.45 0 0 0</pose><geometry><box><size>0.16 1.65 0.9</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>

        <!-- Partition 2 (x = 4.35, doorway y in [-0.95, +0.75]) -->
        <collision name="p2_n_c"><pose>4.35 1.57 0.45 0 0 0</pose><geometry><box><size>0.16 1.65 0.9</size></box></geometry></collision>
        <visual name="p2_n_v"><pose>4.35 1.57 0.45 0 0 0</pose><geometry><box><size>0.16 1.65 0.9</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>

        <collision name="p2_s_c"><pose>4.35 -1.67 0.45 0 0 0</pose><geometry><box><size>0.16 1.45 0.9</size></box></geometry></collision>
        <visual name="p2_s_v"><pose>4.35 -1.67 0.45 0 0 0</pose><geometry><box><size>0.16 1.45 0.9</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>

        <!-- Structural rubble pillars for rich LiDAR SLAM features -->
        <collision name="pil_1_c"><pose>0.4 1.65 0.40 0 0 0</pose><geometry><box><size>0.36 0.36 0.80</size></box></geometry></collision>
        <visual name="pil_1_v"><pose>0.4 1.65 0.40 0 0 0</pose><geometry><box><size>0.36 0.36 0.80</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>

        <collision name="pil_2_c"><pose>3.0 -1.75 0.40 0 0 0</pose><geometry><box><size>0.40 0.40 0.80</size></box></geometry></collision>
        <visual name="pil_2_v"><pose>3.0 -1.75 0.40 0 0 0</pose><geometry><box><size>0.40 0.40 0.80</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>

        <collision name="pil_3_c"><pose>6.6 -1.55 0.40 0 0 0</pose><geometry><box><size>0.45 0.45 0.80</size></box></geometry></collision>
        <visual name="pil_3_v"><pose>6.6 -1.55 0.40 0 0 0</pose><geometry><box><size>0.45 0.45 0.80</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material></visual>
      </link>
    </model>

    <!-- Standing Human Survivor (face -X toward approaching TurtleBot3) -->
    <model name="survivor_person">
      <static>true</static>
      <pose>5.85 0.45 0.0 0 0 3.14159</pose>
      <link name="body">
        <collision name="col">
          <pose>0 0 0.85 0 0 0</pose>
          <geometry><cylinder><radius>0.22</radius><length>1.70</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0.78 0 0 -1.5708</pose>
          <geometry>
            <mesh>
              <uri>file:///usr/share/gazebo-11/media/models/stand.dae</uri>
              <scale>0.85 0.85 0.85</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
