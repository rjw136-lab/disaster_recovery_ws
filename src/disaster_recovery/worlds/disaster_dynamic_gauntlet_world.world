<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <scene><shadows>false</shadows></scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0.0 0.0 12.5 0 1.57 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>500.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- 8.8m x 8.8m hall with staggered partition baffles + 2 moving dynamic obstacles -->
    <model name="dynamic_gauntlet_walls">
      <static>1</static>
      <link name="walls">
        <collision name="wall_n_c"><pose>0.0 4.4 0.5 0 0 0</pose><geometry><box><size>9.0 0.2 1.0</size></box></geometry></collision>
        <visual name="wall_n_v"><pose>0.0 4.4 0.5 0 0 0</pose><geometry><box><size>9.0 0.2 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_s_c"><pose>0.0 -4.4 0.5 0 0 0</pose><geometry><box><size>9.0 0.2 1.0</size></box></geometry></collision>
        <visual name="wall_s_v"><pose>0.0 -4.4 0.5 0 0 0</pose><geometry><box><size>9.0 0.2 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_w_c"><pose>-4.4 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 9.0 1.0</size></box></geometry></collision>
        <visual name="wall_w_v"><pose>-4.4 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 9.0 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <collision name="wall_e_c"><pose>4.4 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 9.0 1.0</size></box></geometry></collision>
        <visual name="wall_e_v"><pose>4.4 0.0 0.5 0 0 0</pose><geometry><box><size>0.2 9.0 1.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material></visual>

        <!-- Staggered structural baffles creating figure-8 / crossing gauntlet -->
        <collision name="baffle_sw_c"><pose>-1.6 -1.5 0.4 0 0 0</pose><geometry><box><size>2.2 0.22 0.8</size></box></geometry></collision>
        <visual name="baffle_sw_v"><pose>-1.6 -1.5 0.4 0 0 0</pose><geometry><box><size>2.2 0.22 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>

        <collision name="baffle_ne_c"><pose>1.6 1.5 0.4 0 0 0</pose><geometry><box><size>2.2 0.22 0.8</size></box></geometry></collision>
        <visual name="baffle_ne_v"><pose>1.6 1.5 0.4 0 0 0</pose><geometry><box><size>2.2 0.22 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>

        <collision name="baffle_c_c"><pose>0.0 0.0 0.4 0 0 0</pose><geometry><box><size>0.65 1.80 0.8</size></box></geometry></collision>
        <visual name="baffle_c_v"><pose>0.0 0.0 0.4 0 0 0</pose><geometry><box><size>0.65 1.80 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>

    <!-- Moving patrolling dynamic obstacles driven by libgazebo_ros_planar_move.so -->
    <model name="dyn_obs_1">
      <pose>1.0 2.65 0.25 0 0 0</pose>
      <link name="link">
        <gravity>0</gravity>
        <inertial>
          <mass>20.0</mass>
          <inertia><ixx>0.5</ixx><iyy>0.5</iyy><izz>0.5</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>0.50</length></cylinder></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.50</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
      <plugin name="dyn_obs_1_move" filename="libgazebo_ros_planar_move.so">
        <ros><namespace>/dyn_obs1</namespace></ros>
        <update_rate>20.0</update_rate>
        <publish_odom>false</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
      </plugin>
    </model>

    <model name="dyn_obs_2">
      <pose>-1.0 -2.75 0.25 0 0 0</pose>
      <link name="link">
        <gravity>0</gravity>
        <inertial>
          <mass>20.0</mass>
          <inertia><ixx>0.5</ixx><iyy>0.5</iyy><izz>0.5</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>0.50</length></cylinder></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.50</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
      <plugin name="dyn_obs_2_move" filename="libgazebo_ros_planar_move.so">
        <ros><namespace>/dyn_obs2</namespace></ros>
        <update_rate>20.0</update_rate>
        <publish_odom>false</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
      </plugin>
    </model>
  </world>
</sdf>
